# BEGPHARMA — Variables d'environnement racines
# Pour démarrer l'environnement backend :
# cd backend && cp .env.example .env && php artisan key:generate

APP_NAME=BEGPHARMA
APP_ENV=local
APP_TIMEZONE=Africa/Porto-Novo

# PostgreSQL 16
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=bestpharma_dev
DB_USERNAME=postgres
DB_PASSWORD=
