APP_NAME=BestPharma
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=bestpharma
DB_USERNAME=postgres
DB_PASSWORD=secretpassword
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
FILESYSTEM_DISK=local
MAIL_MAILER=log
FRONTEND_URL=http://localhost:3001

# Local inbox is never available in production.
SOCLE_LOCAL_INBOX=false
SOCLE_REMINDER_DAYS=3
SOCLE_EXPIRED_TOKEN_RETENTION_DAYS=7
INVITATION_DAYS=7
SUPPORT_PENDING_DAYS=14

# Optional Google OAuth: disabled until all three values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Configure SMTP outside version control for real email delivery.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.test
MAIL_FROM_NAME=BestPharma

# Diagnostic capture stays closed pending a reviewed secret-redaction policy.
TELESCOPE_ENABLED=false

# Business decision: mandatory MFA for platform/office admins and coordinators.
SOCLE_REQUIRE_PRIVILEGED_MFA=true
