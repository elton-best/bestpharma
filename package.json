{
  "name": "begpharma-workspace",
  "private": true,
  "description": "BEGPHARMA — Application de gestion d'officine au Bénin (Monorepo root)",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev:all": "node scripts/start-dev.mjs",
    "dev:backend": "cd backend && php artisan serve --host=127.0.0.1 --port=8001",
    "build": "npm run build --prefix frontend",
    "test": "npm test --prefix frontend",
    "test:backend": "cd backend && php artisan test",
    "test:all": "npm test --prefix frontend && cd backend && php artisan test",
    "inventaire:corpus": "node scripts/inventorier-corpus.mjs",
    "test:audit-postgres": "node scripts/tester-audit-postgres.mjs"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "devDependencies": {
    "pg": "^8.23.1"
  }
}
